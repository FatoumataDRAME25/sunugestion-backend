# Modèle : copier en .env.docker et renseigner les valeurs (ce fichier-là n est pas suivi par git)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# ── Réglages propres à Docker (prioritaires sur .env) ──
# Jamais DEBUG=True hors développement : Django afficherait ses détails internes en cas d'erreur
DEBUG=False
N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/extract-persons
# Intermédiaires entre le client et Django : ngrok puis nginx. Reste correct
# sans ngrok (accès direct par localhost : un seul intermédiaire présent)
NUM_PROXIES=2
ALLOWED_HOSTS=localhost,127.0.0.1,backend,<adresse-ngrok>
PAYDUNYA_RETURN_URL=https://<adresse-ngrok>/paiement/retour
PAYDUNYA_CANCEL_URL=https://<adresse-ngrok>/paiement/annule
